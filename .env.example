# MechEval Model Provider Credentials
# Add your API keys below if running live evaluations against cloud providers.
# If no keys are provided, MechEval falls back to its deterministic mock / recorded trajectory evaluator.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Default benchmark settings
MECHEVAL_DEFAULT_MODEL=mock-gpt4o
MECHEVAL_NUM_TRIALS=3
MECHEVAL_TIMEOUT_SECONDS=60
